# Porta interna do servidor (dentro do container)
PORT=3000

# Senha INICIAL de acesso (só é usada no PRIMEIRO boot para semear o banco).
# Depois disso a senha vive no banco e é trocada dentro do app (Configurações).
# Gere uma forte: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=troque-este-token

# Segredo para assinar os cookies de sessão (JWT). TROQUE em produção.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# Caminho do arquivo do banco SQLite (padrão: data/painel.sqlite)
DB_PATH=data/painel.sqlite

# "production" no VPS (ativa cookie Secure — exige HTTPS)
NODE_ENV=development

# Fuso do agendador de lembretes (padrão America/Sao_Paulo).
# TZ_APP=America/Sao_Paulo

# --- Lembretes pelo WhatsApp (assistente-ops da iaiaBrasil) ---
# Endpoint local da assistente que reenvia o lembrete ao dono no WhatsApp.
# OPS_NOTIFY_URL=http://127.0.0.1:8765/notify
# Segredo compartilhado com a assistente (mesmo valor no .env dela: OPS_NOTIFY_SECRET).
# OPS_NOTIFY_SECRET=

# --- Google Agenda (somente leitura na tela Hoje) ---
# Credenciais do cliente OAuth (Google Cloud → APIs → Credenciais).
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Redirect (deve bater EXATO com o cadastrado no Google):
# GOOGLE_REDIRECT_URI=https://iaiabrasil.com/pfin/api/gcal/callback
