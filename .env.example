# Porta interna do servidor (dentro do container)
PORT=3000

# Senha INICIAL de acesso (só é usada no PRIMEIRO boot para semear o banco).
# Depois disso a senha vive no banco e é trocada dentro do app (Configurações).
# Gere uma forte: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_TOKEN=troque-este-token

# Segredo para assinar os cookies de sessão (JWT). TROQUE em produção.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# Caminho do arquivo do banco SQLite (padrão: data/painel.sqlite)
DB_PATH=data/painel.sqlite

# "production" no VPS (ativa cookie Secure — exige HTTPS)
NODE_ENV=development
